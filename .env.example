# Copie ce fichier en .env et remplis tes clés (le .env n'est jamais envoyé sur GitHub).
# Guide pour obtenir les clés : voir la section « Détecteur de tendances » du README.

# Twitch : https://dev.twitch.tv/console
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# YouTube Data API v3 : https://console.cloud.google.com
YOUTUBE_API_KEY=

# Liste de souhaits Steam (publique) : SteamID64 à 17 chiffres, sans clé API
STEAM_ID=
